@page "/play"
@using Servitor.App.ArmyBuilder.State
@using Servitor.App.BattleTracker.Components
@using Servitor.App.BattleTracker.State
@using Servitor.App.Scoring.Components
@using Servitor.App.Shared.Dialogs
@using Servitor.App.Shared.Pager
@using Servitor.App.Shared.WakeLock
@implements IAsyncDisposable
@inject IBattleProgressState Progress
@inject IArmyBuilderState Army
@inject IActiveArmyStore ActiveArmy
@inject IWakeLockService WakeLock

<PageTitle>Play</PageTitle>

<div class="play-page">
    <h1>Play</h1>

    @if (Army.Units.Count == 0)
    {
        <section class="play-empty">
            <p>No army loaded — the battle tracker needs an army to follow.</p>
            <a href="" class="import-link">Import Army</a>
            <a href="build" class="build-link">Build one instead</a>
        </section>
    }
    else
    {
        <div class="play-header">
            <BattleProgressBar />

            <div class="play-tools">
                <CommandPointsPanel />

                <div class="play-actions">
                    <button type="button" class="open-opponent" @onclick="() => _showOpponent = true">Opponent's Army</button>
                    <button type="button" class="open-scoring" @onclick="() => _showScoring = true">Scoring</button>
                </div>
            </div>
        </div>

        <ScreenPager WideColumns="@WideColumns">
            <PagerScreen Title="Action Queue">
                <ActionQueuePanel />
            </PagerScreen>
            <PagerScreen Title="Units">
                <UnitsPanel />
            </PagerScreen>
            <PagerScreen Title="Commands" WideDrawer="true" DrawerOpen="_commandsOpen">
                <CommandsPanel />
            </PagerScreen>
        </ScreenPager>

        <div class="commands-drawer-backdrop @(_commandsOpen ? "open" : null)" @onclick="() => _commandsOpen = false"></div>
        <button type="button" class="commands-toggle" aria-expanded="@(_commandsOpen ? "true" : "false")" @onclick="() => _commandsOpen = !_commandsOpen">Commands</button>

        @if (_showOpponent)
        {
            <OpponentArmyModal OnClose="() => _showOpponent = false" />
        }

        @if (_showScoring)
        {
            <ModalFrame Title="Scoring" Fill="true" OnClose="() => _showScoring = false">
                <ScoringPanel />
            </ModalFrame>
        }
    }
</div>

@code {
    private const string WideColumns = "minmax(0, 1fr) minmax(0, 2fr)";

    private bool _commandsOpen;
    private bool _showOpponent;
    private bool _showScoring;

    protected override async Task OnInitializedAsync()
    {
        Army.Changed += OnArmyChanged;
        await Progress.LoadAsync();
        if (Army.Units.Count == 0)
        {
            await ActiveArmy.RestoreAsync(Army);
        }
        else
        {
            await ActiveArmy.SaveAsync(Army);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await WakeLock.AcquireAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Army.Changed -= OnArmyChanged;
        await WakeLock.ReleaseAsync();
    }

    private void OnArmyChanged() => InvokeAsync(StateHasChanged);
}

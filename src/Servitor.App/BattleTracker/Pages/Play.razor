@page "/play"
@using Servitor.App.ArmyBuilder.State
@using Servitor.App.BattleTracker.Components
@using Servitor.App.BattleTracker.State
@using Servitor.App.Scoring.Components
@using Servitor.App.Shared.Dialogs
@implements IDisposable
@inject IBattleProgressState Progress
@inject IArmyBuilderState Army
@inject IActiveArmyStore ActiveArmy

<PageTitle>Play</PageTitle>

<h1>Play</h1>

@if (Army.Units.Count == 0)
{
    <section class="play-empty">
        <p>No army loaded — the battle tracker needs an army to follow.</p>
        <a href="" class="import-link">Import Army</a>
        <a href="build" class="build-link">Build one instead</a>
    </section>
}
else
{
    <BattleProgressBar />
    <CommandPointsPanel />

    <nav class="play-nav">
        <button type="button" class="chip view-queue @(_view == PlayView.Queue ? "selected" : "")" @onclick="() => _view = PlayView.Queue">Action Queue</button>
        <button type="button" class="chip view-units @(_view == PlayView.Units ? "selected" : "")" @onclick="() => _view = PlayView.Units">Units</button>
        <button type="button" class="chip view-commands @(_view == PlayView.Commands ? "selected" : "")" @onclick="() => _view = PlayView.Commands">Commands</button>
        <button type="button" class="chip open-opponent" @onclick="() => _showOpponent = true">Opponent's Army</button>
        <button type="button" class="chip open-scoring" @onclick="() => _showScoring = true">Scoring</button>
    </nav>

    @switch (_view)
    {
        case PlayView.Commands:
            <CommandsPanel />
            break;
        case PlayView.Units:
            <UnitsPanel />
            break;
        default:
            <ActionQueuePanel />
            break;
    }

    @if (_showOpponent)
    {
        <OpponentArmyModal OnClose="() => _showOpponent = false" />
    }

    @if (_showScoring)
    {
        <ModalFrame Title="Scoring" OnClose="() => _showScoring = false">
            <ScoringPanel />
        </ModalFrame>
    }
}

@code {
    private enum PlayView
    {
        Queue,
        Units,
        Commands,
    }

    private PlayView _view = PlayView.Queue;
    private bool _showOpponent;
    private bool _showScoring;

    protected override async Task OnInitializedAsync()
    {
        Army.Changed += OnArmyChanged;
        await Progress.LoadAsync();
        if (Army.Units.Count == 0)
        {
            await ActiveArmy.RestoreAsync(Army);
        }
        else
        {
            await ActiveArmy.SaveAsync(Army);
        }
    }

    public void Dispose() => Army.Changed -= OnArmyChanged;

    private void OnArmyChanged() => InvokeAsync(StateHasChanged);
}

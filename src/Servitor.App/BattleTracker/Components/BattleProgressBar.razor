@using Servitor.App.BattleTracker.State
@using Servitor.App.Scoring.Tracking
@using Servitor.App.Shared.Viewport
@implements IDisposable
@inject IBattleProgressState Progress
@inject IViewportInterop Viewport

<section class="battle-progress">
    <div class="round-counter">
        <button type="button" class="round-previous" disabled="@(Progress.Round <= BattleProgressState.MinRound)" @onclick="Progress.DecrementRoundAsync">−</button>
        <span class="round-label">Battle Round <strong>@Progress.Round</strong></span>
        <button type="button" class="round-next" disabled="@(Progress.Round >= BattleProgressState.MaxRound)" @onclick="Progress.IncrementRoundAsync">+</button>
    </div>

    <p class="turn-indicator @(Progress.ActiveTurn == Side.You ? "your-turn" : "enemy-turn")">
        @(Progress.ActiveTurn == Side.You ? "Your turn" : "Enemy turn")
    </p>

    @if (Progress.Phase == BattlePhase.Deployment)
    {
        <div class="first-turn-picker">
            <span>First turn:</span>
            <button type="button" class="chip first-turn-you @(Progress.FirstTurn == Side.You ? "selected" : "")" @onclick="() => Progress.SetFirstTurnAsync(Side.You)">You</button>
            <button type="button" class="chip first-turn-enemy @(Progress.FirstTurn == Side.Enemy ? "selected" : "")" @onclick="() => Progress.SetFirstTurnAsync(Side.Enemy)">Enemy</button>
        </div>
    }

    <div class="phase-stepper">
        <button type="button" class="phase-previous" aria-label="Previous phase" disabled="@(Progress.Phase == BattlePhase.Deployment)" @onclick="Progress.PreviousPhaseAsync">◀</button>
        <div class="phase-chips" @ref="_phaseChips">
            @foreach (var phase in Enum.GetValues<BattlePhase>())
            {
                var target = phase;
                <button type="button" class="chip phase-chip @(Progress.Phase == target ? "selected" : "")" @onclick="() => Progress.SetPhaseAsync(target)">@BattlePhaseLabels.Label(target)</button>
            }
        </div>
        <button type="button" class="phase-next" aria-label="Next phase" @onclick="Progress.NextPhaseAsync">▶</button>
    </div>
</section>

@code {
    private ElementReference _phaseChips;
    private BattlePhase? _centeredPhase;

    protected override void OnInitialized() => Progress.Changed += OnProgressChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_centeredPhase != Progress.Phase)
        {
            _centeredPhase = Progress.Phase;
            await Viewport.ScrollSelectedIntoViewAsync(_phaseChips);
        }
    }

    public void Dispose() => Progress.Changed -= OnProgressChanged;

    private void OnProgressChanged() => InvokeAsync(StateHasChanged);
}

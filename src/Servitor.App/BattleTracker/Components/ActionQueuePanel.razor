@using Servitor.App.ArmyBuilder.State
@using Servitor.App.BattleTracker.ActionQueue
@using Servitor.App.BattleTracker.State
@using Servitor.App.RulesData.Loading
@using Servitor.App.Scoring.Tracking
@using Servitor.RulesData.Domain
@using Servitor.RulesData.Merging
@implements IDisposable
@inject IBattleProgressState Progress
@inject IStratagemUsageState Usage
@inject IArmyBuilderState Army
@inject IMergedRulesDataProvider RulesData

<section class="action-queue">
    <h2>Action Queue — @BattlePhaseLabels.Label(Progress.Phase)</h2>

    @if (_isLoading)
    {
        <p>Loading rules data…</p>
    }
    else if (_data is null)
    {
        <p class="queue-empty">No rules data loaded.</p>
    }
    else
    {
        var context = new TurnContext(Progress.Phase, Progress.ActiveTurn, Progress.FirstTurn);
        var queue = ActionQueueBuilder.Build(_data, Army.Setup, context);

        <h3 class="queue-heading">Core Stratagems</h3>
        @Cards(queue.CoreStratagems)

        <ArmyRulesPanel Entries="_rules" Context="context" />

        <h3 class="queue-heading">Detachment Stratagems</h3>
        @if (queue.DetachmentStratagems.Count == 0)
        {
            <p class="queue-empty">No detachment stratagems for this phase.</p>
        }
        else
        {
            @Cards(queue.DetachmentStratagems)
        }
    }
</section>

@code {
    private MergedRulesData? _data;
    private IReadOnlyList<ArmyRuleEntry> _rules = [];
    private IReadOnlyList<UnitChoice> _units = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        Progress.Changed += OnChanged;
        Army.Changed += OnArmyChanged;
        Usage.Changed += OnChanged;
        await Usage.LoadAsync();
        _data = await RulesData.GetAsync();
        _rules = ArmyRuleCollector.Collect(_data, Army.Setup, Army.Units);
        _units = UnitChoice.From(Army.Units);
        _isLoading = false;
    }

    public void Dispose()
    {
        Progress.Changed -= OnChanged;
        Army.Changed -= OnArmyChanged;
        Usage.Changed -= OnChanged;
    }

    private RenderFragment Cards(IReadOnlyList<Stratagem> stratagems) => builder =>
    {
        foreach (var stratagem in stratagems)
        {
            builder.OpenComponent<StratagemCard>(0);
            builder.SetKey(stratagem.Id);
            builder.AddComponentParameter(1, nameof(StratagemCard.Stratagem), stratagem);
            builder.AddComponentParameter(2, nameof(StratagemCard.Units), _units);
            builder.CloseComponent();
        }
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnArmyChanged()
    {
        _rules = ArmyRuleCollector.Collect(_data, Army.Setup, Army.Units);
        _units = UnitChoice.From(Army.Units);
        OnChanged();
    }
}

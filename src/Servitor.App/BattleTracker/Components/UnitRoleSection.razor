@using Servitor.App.BattleTracker.State
@using Servitor.App.BattleTracker.Units
@using Servitor.App.RulesData.Components
@using Servitor.RulesData.Domain
@inject IUnitConditionState Conditions

@{
    var sheet = Role.Unit.Datasheet;
    var stats = sheet.StatLine;
    var destroyed = Role.Loadout.Groups.All(g => GroupWounds.IsDestroyed(g, ConditionOf(g)));
    var abilities = sheet.NamedAbilities.Concat(sheet.WargearAbilities).Where(a => !AttachmentAbilities.Contains(a.Name, StringComparer.OrdinalIgnoreCase)).ToList();
    var rows = Role.Loadout.Weapons
        .SelectMany(w => w.Profiles.Select(p => (Weapon: w, Profile: p)))
        .OrderBy(r => r.Profile.Type)
        .ToList();
}

<section class="role-section @(destroyed ? "role-destroyed" : "")">
    @if (ShowRoleLabel)
    {
        <h4 class="role-title">@Role.Label: @sheet.Name @(destroyed ? "(destroyed)" : "")</h4>
    }

    <p class="stat-badges">
        <span class="badge stat">M @stats.Movement</span>
        <span class="badge stat">T @stats.Toughness</span>
        <span class="badge stat">Sv @stats.Save</span>
        @if (stats.InvulnerableSave is not null)
        {
            <span class="badge stat">Inv @stats.InvulnerableSave</span>
        }
        <span class="badge stat">W @stats.Wounds</span>
        <span class="badge stat">Ld @stats.Leadership</span>
        <span class="badge stat">OC @stats.ObjectiveControl</span>
    </p>

    <ul class="model-groups">
        @foreach (var group in Role.Loadout.Groups)
        {
            var key = UnitKeys.GroupKey(Role.UnitKey, group);
            var condition = Conditions.Of(key);
            var alive = GroupWounds.Alive(group, condition);
            var groupDestroyed = alive == 0;
            <li class="model-group @(groupDestroyed ? "group-destroyed" : "")">
                <span class="group-label">@group.Models× @group.Label</span>
                <span class="model-dots" title="@alive of @group.Models models alive">@Dots(group.Models, alive)</span>
                <span class="wounds-readout">
                    Wounds left <strong>@GroupWounds.WoundsRemaining(group, condition)</strong> / @GroupWounds.MaxDamage(group)
                    @if (group.WoundsPerModel > 1 && !groupDestroyed)
                    {
                        <text> · hurt model <strong>@GroupWounds.WoundedModelRemaining(group, condition)</strong> / @group.WoundsPerModel</text>
                    }
                </span>
                <span class="group-actions">
                    <button type="button" class="wound-down" aria-label="Take a wound" disabled="@groupDestroyed"
                            @onclick="() => Conditions.AdjustDamageAsync(key, group, 1)">−</button>
                    <button type="button" class="wound-up" aria-label="Heal a wound" disabled="@(condition.Damage == 0)"
                            @onclick="() => Conditions.AdjustDamageAsync(key, group, -1)">+</button>
                    <button type="button" class="add-token" @onclick="() => Conditions.AddTokenAsync(key)">+ Token</button>
                    @if (condition.Tokens > 0)
                    {
                        <span class="token-count">Tokens: @condition.Tokens</span>
                        <button type="button" class="remove-token" aria-label="Remove a token" @onclick="() => Conditions.RemoveTokenAsync(key)">−</button>
                    }
                    @if (groupDestroyed)
                    {
                        <button type="button" class="restore-group" @onclick="() => Conditions.RestoreGroupAsync(key)">Restore</button>
                    }
                </span>
            </li>
        }
    </ul>

    @if (rows.Count > 0)
    {
        <table class="weapon-table">
            <thead>
                <tr><th>Name</th><th>Range</th><th>Attack</th><th>Skill</th><th>Strength</th><th>AP</th><th>Damage</th><th>Rules</th></tr>
            </thead>
            <tbody>
                @foreach (var (weapon, profile) in rows)
                {
                    <tr class="@(profile.Type == WeaponType.Ranged ? "ranged" : "melee")">
                        <td class="weapon-name">@profile.Name <span class="model-dots">@Dots(weapon.Models, AliveWith(weapon))</span></td>
                        <td>@(profile.Range ?? "Melee")</td>
                        <td>@profile.Attacks</td>
                        <td>@profile.Skill</td>
                        <td>@profile.Strength</td>
                        <td>@profile.ArmourPenetration</td>
                        <td>@profile.Damage</td>
                        <td class="weapon-rules">
                            @foreach (var rule in profile.Keywords.Where(k => k != "-"))
                            {
                                <RuleKeyword Text="@rule" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @foreach (var weapon in Role.Loadout.Weapons.Where(w => w.Profiles.Count == 0))
    {
        <p class="weapon-unknown">@weapon.Name <span class="model-dots">@Dots(weapon.Models, AliveWith(weapon))</span></p>
    }

    @if (abilities.Count > 0)
    {
        <details class="role-abilities">
            <summary>Abilities (@abilities.Count)</summary>
            @foreach (var ability in abilities)
            {
                <h5>@ability.Name</h5>
                <div class="ability-text">@MarkdownRenderer.Render(ability.Description)</div>
            }
        </details>
    }

    <p class="pills">
        @foreach (var keyword in sheet.Keywords)
        {
            <RuleKeyword Text="@keyword" />
        }
    </p>
</section>

@code {
    private static readonly string[] AttachmentAbilities = ["Leader", "Support"];

    [Parameter, EditorRequired]
    public UnitRole Role { get; set; } = default!;

    [Parameter]
    public bool ShowRoleLabel { get; set; }

    private GroupCondition ConditionOf(ModelGroup group) => Conditions.Of(UnitKeys.GroupKey(Role.UnitKey, group));

    private RenderFragment Dots(int models, int alive) => builder =>
    {
        for (var i = 0; i < models; i++)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", i < alive ? "dot" : "dot dead");
            builder.CloseElement();
        }
    };

    private int AliveWith(EquippedWeapon weapon) =>
        Role.Loadout.GroupsWith(weapon).Sum(g => GroupWounds.Alive(g, ConditionOf(g)));
}

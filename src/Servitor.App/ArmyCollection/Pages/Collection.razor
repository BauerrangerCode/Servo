@page "/collection"
@using Servitor.App.ArmyBuilder.State
@using Servitor.App.ArmyCollection.Resolution
@using Servitor.App.ArmyCollection.State
@using Servitor.App.RulesData.Loading
@using Servitor.RulesData.Merging
@inject IArmyCollectionStore CollectionStore
@inject IArmyBuilderState State
@inject IMergedRulesDataProvider RulesData
@inject IDatasheetCatalog Catalog
@inject NavigationManager Nav

<PageTitle>My Collection</PageTitle>

<h1>My Collection</h1>

@if (!_isLoaded)
{
    <p>Loading…</p>
}
else if (_armies.Count == 0)
{
    <p class="collection-empty">No saved armies yet. Build or import one, then save it here.</p>
}
else
{
    <ul class="collection-list">
        @foreach (var army in _armies)
        {
            <li class="collection-entry">
                <span class="collection-name">@army.Name</span>
                <span class="collection-detail">@FactionName(army.FactionId) · @army.BattleSizeName · @army.Units.Count units</span>
                <span class="collection-saved">Saved @army.SavedAtUtc.LocalDateTime.ToString("g")</span>
                @if (_pendingDeleteId == army.Id)
                {
                    <span class="confirm-delete">Delete "@army.Name"?</span>
                    <button type="button" class="confirm-delete-yes" @onclick="@(() => ConfirmDelete(army.Id))">Yes, delete</button>
                    <button type="button" class="cancel-delete" @onclick="CancelDelete">Cancel</button>
                }
                else
                {
                    <button type="button" @onclick="@(() => Open(army, "build"))">Open in Build</button>
                    <button type="button" @onclick="@(() => Open(army, "play"))">Open in Play</button>
                    <button type="button" class="delete-button" @onclick="@(() => RequestDelete(army.Id))">Delete</button>
                }
            </li>
        }
    </ul>
}

@if (_errors.Count > 0)
{
    <ul class="collection-errors">
        @foreach (var error in _errors)
        {
            <li>@error</li>
        }
    </ul>
}

<a href="" class="import-fallback">Back to Import</a>

@code {
    private IReadOnlyList<SavedArmy> _armies = [];
    private MergedRulesData? _data;
    private bool _isLoaded;
    private List<string> _errors = [];
    private Guid? _pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        _armies = await CollectionStore.ListAsync();
        _data = await RulesData.GetAsync();
        _isLoaded = true;
    }

    private string FactionName(string factionId) =>
        _data?.Factions.FirstOrDefault(f => f.FactionId == factionId)?.Name ?? factionId;

    private async Task Open(SavedArmy army, string destination)
    {
        _errors = [];
        var result = await SavedArmyResolver.ResolveAsync(army, State, RulesData, Catalog);
        if (!result.IsSuccess)
        {
            _errors = [.. result.Errors];
            return;
        }

        Nav.NavigateTo(destination);
    }

    private void RequestDelete(Guid id) => _pendingDeleteId = id;

    private void CancelDelete() => _pendingDeleteId = null;

    private async Task ConfirmDelete(Guid id)
    {
        await CollectionStore.DeleteAsync(id);
        _armies = await CollectionStore.ListAsync();
        _pendingDeleteId = null;
    }
}

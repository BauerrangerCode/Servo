<div class="modal-backdrop" role="presentation">
    <section class="modal-dialog @(Fill ? "modal-dialog-fill" : null)" role="dialog" aria-modal="true" aria-label="@Title">
        <header>
            <h2>@Title</h2>
            <div>
                @Actions
                <button type="button" class="modal-close" @onclick="OnClose">Close</button>
            </div>
        </header>
        <div class="modal-body">
            @ChildContent
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    /// <summary>Extra buttons next to Close.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>The dialog takes the full available height, so content that sizes itself to its parent (a pager) has room.</summary>
    [Parameter]
    public bool Fill { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

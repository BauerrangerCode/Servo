@namespace Servitor.App.RulesData.Components
@using Servitor.RulesData.Domain

<section class="ability-list">
    <h3>@Title</h3>
    @* Each instance renders as its own entry, even if two abilities share a name (see docs/Open-Questions-Catalog.md Q2). *@
    @foreach (var ability in Abilities)
    {
        <div class="ability">
            <h4>@ability.Name</h4>
            @if (!string.IsNullOrWhiteSpace(ability.Description))
            {
                <div class="ability-description">@MarkdownRenderer.Render(ability.Description)</div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<Ability> Abilities { get; set; } = [];
}

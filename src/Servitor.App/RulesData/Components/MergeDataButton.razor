@using System.Text.Json
@using Microsoft.JSInterop
@using Servitor.App.RulesData.Merging
@using Servitor.App.Shared.Files
@using Servitor.RulesData.Merging
@inject IRulesDataMergeService MergeService
@inject IFileDownloadService FileDownload

<button type="button" class="merge-data-button" disabled="@_isRunning" @onclick="RunMergeAsync">
    @(_isRunning ? _progressText : "Merge data")
</button>

@if (_error is not null || _result is not null)
{
    <div class="merge-report-dialog" role="dialog" aria-label="Merge report">
        <div class="merge-report-panel">
            @if (_error is not null)
            {
                <h2>Merge failed</h2>
                <p class="merge-report-error">@_error</p>
            }
            else if (_result is { } result)
            {
                <h2>Merge report</h2>
                @if (!result.Stored)
                {
                    <p class="merge-report-error">No BSData datasheets were found, so nothing was stored and the data in use is unchanged.</p>
                }
                <pre class="merge-report-text">@_reportMarkdown</pre>
            }

            <div class="merge-report-actions">
                @if (_result is not null)
                {
                    <button type="button" @onclick="DownloadReportAsync">Download report</button>
                }
                <button type="button" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private const string ReportFileName = "merge-report.md";
    private const string ReportMimeType = "text/markdown";

    // The merge reports once per source file; re-rendering on every one of the ~1,700 datasheet files would cost
    // more than the merge itself, so the button only repaints on every Nth step.
    private const int RenderEveryNthStep = 25;

    private bool _isRunning;
    private string _progressText = "";
    private string? _error;
    private InAppMergeResult? _result;
    private string _reportMarkdown = "";

    private async Task RunMergeAsync()
    {
        _isRunning = true;
        _error = null;
        _result = null;
        _progressText = "Merging…";

        var progress = new Progress<MergeProgress>(step =>
        {
            _progressText = $"{step.Stage} {step.Completed}/{step.Total}";
            if (step.Completed % RenderEveryNthStep == 0 || step.Completed == step.Total)
            {
                InvokeAsync(StateHasChanged);
            }
        });

        try
        {
            _result = await MergeService.MergeAsync(progress);
            _reportMarkdown = MergeReportFormatter.ToMarkdown(_result.Outcome.Report);
        }
        catch (HttpRequestException ex)
        {
            _error = $"A source file could not be fetched: {ex.Message}";
        }
        catch (JsonException ex)
        {
            _error = $"A source file could not be parsed: {ex.Message}";
        }
        catch (JSException ex)
        {
            _error = $"The merged data could not be stored: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
        }
    }

    private Task DownloadReportAsync() => FileDownload.DownloadTextAsync(ReportFileName, _reportMarkdown, ReportMimeType);

    private void Close()
    {
        _result = null;
        _error = null;
    }
}

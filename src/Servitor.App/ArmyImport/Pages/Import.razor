@page "/"
@using Servitor.App.ArmyBuilder.State
@using Servitor.App.ArmyImport.Parsing
@using Servitor.App.ArmyImport.Resolution
@using Servitor.App.RulesData.Loading
@inject IArmyBuilderState State
@inject IMergedRulesDataProvider RulesData
@inject IDatasheetCatalog Catalog
@inject NavigationManager Nav

<PageTitle>Import</PageTitle>

<div class="import-page">
    <h1>Import</h1>

    <section class="import-step">
        <label for="import-text">Paste your army list</label>
        <textarea id="import-text" class="import-textarea" @bind="_pastedText" @bind:event="oninput"
                  placeholder="Paste a Warscribe army list export here…"></textarea>

        @if (_errors.Count > 0)
        {
            <ul class="import-errors">
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <button type="button" class="import-play" disabled="@(_isImporting || string.IsNullOrWhiteSpace(_pastedText))" @onclick="ImportAndPlay">
            @(_isImporting ? "Importing…" : "Import & Play")
        </button>
    </section>

    <nav class="import-links">
        <a href="build" class="build-fallback">Build one instead</a>
        <a href="collection" class="collection-link">My Collection</a>
    </nav>
</div>

@code {
    private string _pastedText = "";
    private bool _isImporting;
    private List<string> _errors = [];

    private async Task ImportAndPlay()
    {
        _errors = [];
        _isImporting = true;

        var parseResult = WarscribeExportParser.Parse(_pastedText);
        if (!parseResult.IsSuccess)
        {
            _errors = [.. parseResult.Errors];
            _isImporting = false;
            return;
        }

        var resolveResult = await ArmyExportResolver.ResolveAsync(parseResult.Export!, State, RulesData, Catalog);
        if (!resolveResult.IsSuccess)
        {
            _errors = [.. resolveResult.Errors];
            _isImporting = false;
            return;
        }

        Nav.NavigateTo("play");
    }
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Servo</AssemblyName>
    <RootNamespace>Servitor.Launcher</RootNamespace>
    <ApplicationIcon>Assets\servo.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The update service project is an executable too; it is only used as a library here. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- No console window on Windows; failures are reported in a message box and in the log file. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Servitor.DataUpdate\Servitor.DataUpdate.csproj" />
  </ItemGroup>

</Project>
